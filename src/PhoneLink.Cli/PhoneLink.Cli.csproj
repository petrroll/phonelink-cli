<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>phonelink</AssemblyName>
    <RootNamespace>PhoneLink</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Unofficial, read-only, library-backed Windows Phone Link CLI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhoneLink.Tests" />
  </ItemGroup>
</Project>
